import muro.*
import trampas.*
import wollok.game.*
import pacman.*
import direcciones.*
import bombasRandom.*
import spawners.*


program juego {

  game.title("PAC MAN")
  game.addVisualCharacter(pacman)
  game.boardGround("fondo.jpg")
  game.height(15)
	game.width(15)


  
  (0..14).forEach({ x => game.addVisual(new Muro(position = game.at(x, 14))) })
  (0..14).forEach({ x => game.addVisual(new Muro(position = game.at(x, 0))) })
  (0..14).forEach({ x => game.addVisual(new Muro(position = game.at(0, x))) })
  (0..14).forEach({ x => game.addVisual(new Muro(position = game.at(14, x))) })

//MUSICA DE FONDO
  const musicaFondo = game.sound("musica_fondo.mp3")
      musicaFondo.shouldLoop(true)
      game.schedule(300, { musicaFondo.play()})



  //MOVIMIENTO PACMAN

  keyboard.left().onPressDo({ pacman.mover(izquierda)})
	keyboard.right().onPressDo({ pacman.mover(derecha)})
	keyboard.up().onPressDo({ pacman.mover(arriba)})
	keyboard.down().onPressDo({ pacman.mover(abajo)})

  // BOMBA PACMAN
  keyboard.b().onPressDo({pacman.ponerBomba() })
  

// BOMBAS AZULES
  game.schedule(5000, { game.addVisual(new BombaRandom (position = game.at(2, 10)))})
  game.schedule(5000,{ game.addVisual(new BombaRandom (position = game.at(12, 10)))})
  game.schedule(5000,{ game.addVisual(new BombaRandom (position = game.at(10, 10)))})


// SPAWNER DISPARADORES
  spawner.spawnearCant_Invasores(2)

// SPAWNER DISPARADORES
  spawner.spawnearCant_Invasores(2)

// COLISIONES 
  game.onCollideDo(pacman, {elemento => elemento.chocoConPacman()})
  game.start()
}