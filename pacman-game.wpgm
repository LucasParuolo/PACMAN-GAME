import muro.*
import trampas.*
import wollok.game.*
import pacman.*
import direcciones.*
import bombasRandom.*
import spawners.*
import menu.*
import fantasmas.*
import mapa.*

program juego {

  var juegoIniciado = false

  game.title("PACMAN INVADERS")
  
  game.boardGround(menu.fondoDeJuego())
  game.height(20)
	game.width(20)


//CONTROLES MENU
  keyboard.num1().onPressDo({
    if (not juegoIniciado) {
        juegoIniciado = true
        menu.iniciar()
        generadorMapa.crear()
    }
    })

  //MOVIMIENTO PACMAN

  keyboard.left().onPressDo({ pacman.mover(izquierda)})
	keyboard.right().onPressDo({ pacman.mover(derecha)})
	keyboard.up().onPressDo({ pacman.mover(arriba)})
	keyboard.down().onPressDo({ pacman.mover(abajo)})

  // BOMBA PACMAN
  keyboard.b().onPressDo({pacman.ponerBomba() })
  





// COLISIONES 
  game.onCollideDo(pacman, {elemento => elemento.chocoConPacman()})
  game.start()
  
}